diff --git a/app/inventory_safe.py b/app/inventory_safe.py
new file mode 100644
--- /dev/null
+++ b/app/inventory_safe.py
@@ -0,0 +1,14 @@
+import threading
+
+stock = {"widget": 10}
+_lock = threading.Lock()
+
+
+def reserve(item: str, qty: int) -> bool:
+    """Called concurrently from many request threads."""
+    with _lock:
+        available = stock.get(item, 0)
+        if available >= qty:
+            stock[item] = available - qty
+            return True
+    return False
